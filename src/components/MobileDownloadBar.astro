---
import Icon from './Icon.astro';
import { siteConfig } from '@/config/site';
import { isPlaceholder } from '@/lib/placeholder';

const pending = isPlaceholder(siteConfig.apkUrl);
const href = pending ? siteConfig.meanwhile.url || '/download/' : siteConfig.apkUrl;
const isExternal = pending && Boolean(siteConfig.meanwhile.url);
---

<div id="mobile-download-bar" class="mobile-download-bar" role="complementary" aria-label={pending ? siteConfig.meanwhile.label : 'Download Gold Rummy'}>
  <a
    href={href}
    class="mobile-download-bar__cta"
    data-pending={pending}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
  >
    <Icon name={pending ? 'external' : 'download'} size={18} />
    <span>{pending ? siteConfig.meanwhile.label : 'Get the Gold Rummy APK'}</span>
  </a>
  <button type="button" class="mobile-download-bar__close" id="mobile-download-bar-close" aria-label="Dismiss download bar">
    <Icon name="close" size={16} />
  </button>
</div>

<script>
  const bar = document.getElementById('mobile-download-bar');
  const closeBtn = document.getElementById('mobile-download-bar-close');
  const DISMISS_KEY = 'gr-mobile-bar-dismissed';

  if (bar && closeBtn) {
    if (sessionStorage.getItem(DISMISS_KEY) === '1') {
      bar.hidden = true;
      document.body.classList.remove('has-mobile-bar');
    }

    closeBtn.addEventListener('click', () => {
      bar.hidden = true;
      document.body.classList.remove('has-mobile-bar');
      sessionStorage.setItem(DISMISS_KEY, '1');
    });
  }
</script>

<style>
  .mobile-download-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.625rem var(--container-pad);
    padding-bottom: calc(0.625rem + env(safe-area-inset-bottom, 0px));
    background: var(--color-emerald-deep);
    border-top: 1px solid rgba(212, 175, 55, 0.35);
    box-shadow: 0 -8px 24px rgba(4, 15, 10, 0.35);
  }

  .mobile-download-bar__cta {
    flex: 1 1 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-btn);
    background: var(--gradient-gold);
    color: var(--color-accent-ink);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .mobile-download-bar__close {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    color: var(--color-on-emerald-faint);
  }

  .mobile-download-bar__close:hover {
    color: var(--color-on-emerald);
  }

  @media (min-width: 900px) {
    .mobile-download-bar {
      display: none;
    }
  }
</style>
