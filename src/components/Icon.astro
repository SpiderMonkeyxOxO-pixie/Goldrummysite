---
// Small hand-drawn line-icon set. Kept as one component so every icon in the
// site shares the same stroke weight/cap style instead of mixing sources.
interface Props {
  name:
    | 'download'
    | 'install'
    | 'shield'
    | 'phone'
    | 'chat'
    | 'mail'
    | 'chevron-down'
    | 'chevron-right'
    | 'menu'
    | 'close'
    | 'copy'
    | 'check'
    | 'warning'
    | 'cards'
    | 'language'
    | 'clock'
    | 'external'
    | 'telegram'
    | 'search'
    | 'lock'
    | 'refresh'
    | 'users'
    | 'file';
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'download' && (
      <>
        <path d="M12 3v12" />
        <path d="M7 10l5 5 5-5" />
        <path d="M4 19.5h16" />
      </>
    )
  }
  {
    name === 'install' && (
      <>
        <rect x="5" y="2.5" width="14" height="19" rx="2.5" />
        <path d="M10.5 6h3" />
        <path d="M9.5 18.5h5" />
      </>
    )
  }
  {
    name === 'shield' && (
      <path d="M12 2.5l7.5 3v5.2c0 4.9-3.2 8.9-7.5 10.8-4.3-1.9-7.5-5.9-7.5-10.8V5.5l7.5-3z" />
    )
  }
  {
    name === 'phone' && (
      <>
        <rect x="6.5" y="2.5" width="11" height="19" rx="2.2" />
        <path d="M11 19h2" />
      </>
    )
  }
  {
    name === 'chat' && (
      <>
        <path d="M4 5.5h16v11H9l-4 3.5v-3.5H4v-11z" />
        <path d="M8 9.5h8" />
        <path d="M8 12.5h5" />
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2.2" />
        <path d="M4 6.5l8 6 8-6" />
      </>
    )
  }
  {name === 'chevron-down' && <path d="M6 9.5l6 6 6-6" />}
  {name === 'chevron-right' && <path d="M9.5 6l6 6-6 6" />}
  {
    name === 'menu' && (
      <>
        <path d="M4 6.5h16" />
        <path d="M4 12h16" />
        <path d="M4 17.5h16" />
      </>
    )
  }
  {
    name === 'close' && (
      <>
        <path d="M6 6l12 12" />
        <path d="M18 6l-12 12" />
      </>
    )
  }
  {
    name === 'copy' && (
      <>
        <rect x="9" y="9" width="11" height="11" rx="2" />
        <path d="M15 9V6.5A2.5 2.5 0 0012.5 4H6.5A2.5 2.5 0 004 6.5v6A2.5 2.5 0 006.5 15H9" />
      </>
    )
  }
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7" />}
  {
    name === 'warning' && (
      <>
        <path d="M12 3.5l9.5 16.5H2.5L12 3.5z" />
        <path d="M12 10v4.2" />
        <path d="M12 17.3h.01" />
      </>
    )
  }
  {
    name === 'cards' && (
      <>
        <rect x="3" y="6" width="11" height="15" rx="2" transform="rotate(-8 3 6)" />
        <rect x="9" y="4" width="11" height="15" rx="2" />
      </>
    )
  }
  {
    name === 'language' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18" />
        <path d="M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z" />
      </>
    )
  }
  {
    name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5.3l4 2.3" />
      </>
    )
  }
  {
    name === 'external' && (
      <>
        <path d="M9 5h10v10" />
        <path d="M19 5L5 19" />
      </>
    )
  }
  {
    name === 'telegram' && (
      <path d="M3 11.5l17-7.5-3 16-5.7-4.4-2.7 2.7-.5-4.2L3 11.5z" />
    )
  }
  {
    name === 'search' && (
      <>
        <circle cx="11" cy="11" r="6.5" />
        <path d="M20 20l-4.35-4.35" />
      </>
    )
  }
  {
    name === 'lock' && (
      <>
        <rect x="5" y="10.5" width="14" height="10" rx="2.2" />
        <path d="M8 10.5V8a4 4 0 018 0v2.5" />
      </>
    )
  }
  {name === 'refresh' && <path d="M4 12a8 8 0 0113.5-5.8L20 8M20 4v4h-4M20 12a8 8 0 01-13.5 5.8L4 16m0 4v-4h4" />}
  {
    name === 'users' && (
      <>
        <circle cx="9" cy="8.5" r="3" />
        <path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5" />
        <path d="M16 5.2a3 3 0 010 5.8" />
        <path d="M18.5 14.5c2 .5 3.5 2.2 3.5 4.5" />
      </>
    )
  }
  {
    name === 'file' && (
      <>
        <path d="M7 3h7l5 5v13H7z" />
        <path d="M14 3v5h5" />
      </>
    )
  }
</svg>
