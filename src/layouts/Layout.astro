---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import MobileDownloadBar from '@/components/MobileDownloadBar.astro';
import FloatingContact from '@/components/FloatingContact.astro';
import { siteConfig } from '@/config/site';
import {
  buildOrganizationSchema,
  buildWebsiteSchema,
  buildWebPageSchema,
  buildBreadcrumbSchema,
  buildFaqSchema,
  type BreadcrumbItem,
  type FaqItem,
} from '@/lib/schema';
import '@fontsource/marcellus/400.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '@/styles/global.css';

interface OgImage {
  url: string;
  width: number;
  height: number;
  alt: string;
}

interface Props {
  title: string;
  description: string;
  breadcrumbs?: BreadcrumbItem[];
  faq?: FaqItem[];
  noIndex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: OgImage;
  publishedTime?: string;
  modifiedTime?: string;
  extraSchema?: Record<string, unknown>[];
  /** Set false when `title` already contains the brand name (e.g. the homepage). */
  brandSuffix?: boolean;
}

const {
  title,
  description,
  breadcrumbs,
  faq,
  noIndex = false,
  ogType = 'website',
  ogImage = siteConfig.ogImage,
  publishedTime,
  modifiedTime,
  extraSchema = [],
  brandSuffix = true,
} = Astro.props;

const pageTitle = brandSuffix ? `${title} | ${siteConfig.siteName}` : title;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const absoluteOgImage = new URL(ogImage.url, siteConfig.siteUrl).toString();
const robotsContent = noIndex ? 'noindex, follow' : 'index, follow';

const schemas = [
  buildOrganizationSchema(),
  buildWebsiteSchema(),
  buildWebPageSchema({
    pathname: Astro.url.pathname,
    name: title,
    description,
    hasBreadcrumb: Boolean(breadcrumbs && breadcrumbs.length > 1),
    datePublished: publishedTime,
    dateModified: modifiedTime,
  }),
  ...(breadcrumbs && breadcrumbs.length > 1 ? [buildBreadcrumbSchema(breadcrumbs)] : []),
  ...(faq && faq.length > 0 ? [buildFaqSchema(faq, Astro.url.pathname)] : []),
  ...extraSchema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robotsContent} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={ogImage.alt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#081f16" />

    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
      ))
    }
  </head>
  <body class="has-mobile-bar">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    {breadcrumbs && breadcrumbs.length > 1 && <Breadcrumbs items={breadcrumbs} />}
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FloatingContact />
    <MobileDownloadBar />
  </body>
</html>
